---
import { eventEndISO, eventTypeLabel, formatEventDate, type EventEntry } from '../lib/events'
import { needsTag } from '../lib/review'
import ConfirmTag from './ConfirmTag.astro'
import Icon from './Icon.astro'

interface Props {
  event: EventEntry
  status: 'upcoming' | 'past'
  headingLevel?: 'h3' | 'h4'
}

const { event, status, headingLevel: H = 'h3' } = Astro.props
const d = event.data
const day = d.dateLabel ? null : d.date.getUTCDate()
const month = d.date.toLocaleString('en-IN', { month: 'short', timeZone: 'UTC' })
const year = d.date.getUTCFullYear()
---

<article class:list={['event-card', `event-card--${status}`]} data-event data-end={eventEndISO(d)} data-reveal>
  <div class="event-card__date" aria-hidden="true">
    {day && <span class="event-card__day">{day}</span>}
    <span class="event-card__month">{month}</span>
    <span class="event-card__year">{year}</span>
  </div>
  <div class="event-card__body">
    <p class="event-card__meta">
      <span class="event-card__type">{eventTypeLabel[d.type]}</span>
      <span class="event-card__status" data-event-status>{status === 'upcoming' ? 'Upcoming' : 'Past event'}</span>
      {needsTag(d) && <ConfirmTag source={d.source} />}
    </p>
    <H class="event-card__title">{d.title}</H>
    <ul class="event-card__facts">
      <li><Icon name="calendar" /> <span>{formatEventDate(d)}{d.time && ` · ${d.time}`}</span></li>
      {d.venue && <li><Icon name="pin" /> <span>{d.venue}</span></li>}
    </ul>
    <p class="event-card__summary">{d.summary}</p>
    {d.result && <p class="event-card__result"><strong>Result:</strong> {d.result}</p>}
    {event.rendered?.html && <div class="event-card__details prose" set:html={event.rendered.html} />}
    {
      d.link && (
        <a class="text-link event-card__link" href={d.link} target="_blank" rel="noopener noreferrer">
          {d.linkLabel ?? 'More details'} <Icon name="arrow" />
          <span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .event-card {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: clamp(var(--s-4), 3vw, var(--s-7));
    padding-block: var(--s-6);
    border-top: 1px solid var(--line-on-dark);
  }

  .event-card__date {
    display: grid;
    align-content: start;
    justify-items: start;
    line-height: 1;
    font-variation-settings: 'wdth' 115;
  }

  .event-card__day {
    font-size: 3rem;
    font-weight: 850;
  }

  .event-card__month {
    margin-top: var(--s-2);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--red-on-dark);
  }

  .event-card__year {
    margin-top: var(--s-1);
    font-size: 0.85rem;
    color: var(--muted-on-dark);
  }

  .event-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .event-card__type {
    color: var(--muted-on-dark);
  }

  .event-card__status {
    padding: 0.2em 0.6em;
    border: 1px solid var(--line-on-dark);
  }

  .event-card--upcoming .event-card__status {
    background: var(--red);
    border-color: var(--red);
    color: var(--white);
  }

  .event-card__title {
    margin-top: var(--s-3);
    font-size: var(--step-2);
    text-transform: uppercase;
  }

  .event-card__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    margin: var(--s-4) 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.92rem;
    color: var(--muted-on-dark);
  }

  .event-card__facts li {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }

  .event-card__facts :global(svg) {
    width: 16px;
    height: 16px;
  }

  .event-card__summary,
  .event-card__result,
  .event-card__details {
    margin-top: var(--s-4);
    max-width: var(--measure);
  }

  .event-card__details {
    color: var(--muted-on-dark);
  }

  .event-card__link {
    margin-top: var(--s-5);
  }

  .event-card--past .event-card__day,
  .event-card--past .event-card__title {
    color: var(--muted-on-dark);
  }

  @media (max-width: 520px) {
    .event-card {
      grid-template-columns: 1fr;
      gap: var(--s-3);
    }

    .event-card__date {
      display: flex;
      align-items: baseline;
      gap: var(--s-2);
    }

    .event-card__day {
      font-size: 1.6rem;
    }

    .event-card__month,
    .event-card__year {
      margin: 0;
    }
  }
</style>
