---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'
import BaseLayout from '../../layouts/BaseLayout.astro'
import CtaBand from '../../components/CtaBand.astro'
import Icon from '../../components/Icon.astro'

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft)
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { Content } = await render(post)
const fmt = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
---

<BaseLayout title={post.data.title} description={post.data.description} type="article">
  <article>
    <header class="page-hero">
      <div class="container">
        <a href="/blog/" class="back"><Icon name="arrow-left" /> All posts</a>
        <p class="eyebrow" style="margin-top: var(--s-6)">
          <time datetime={post.data.date.toISOString().slice(0, 10)}>{fmt.format(post.data.date)}</time>
          &nbsp;·&nbsp;{post.data.author}
        </p>
        <h1 class="display post-title">{post.data.title}</h1>
        <p class="lead muted">{post.data.description}</p>
      </div>
    </header>

    <div class="section on-light">
      <div class="container">
        {
          post.data.cover && (
            <Image
              src={post.data.cover}
              alt={post.data.coverAlt ?? ''}
              widths={[800, 1200, 1600]}
              sizes="(min-width: 1100px) 1100px, 100vw"
              class="post-cover"
            />
          )
        }
        <div class="prose post-body">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <CtaBand />
</BaseLayout>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted-on-dark);
  }

  .back:hover {
    color: var(--text-on-dark);
  }

  .back :global(svg) {
    width: 16px;
    height: 16px;
  }

  .post-title {
    font-size: var(--step-4);
    margin-top: var(--s-4) !important;
  }

  .post-cover {
    width: 100%;
    max-width: 1100px;
    margin-bottom: var(--s-8);
  }

  .post-body {
    font-size: 1.08rem;
  }
</style>
