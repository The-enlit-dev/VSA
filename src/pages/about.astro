---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/PageHero.astro'
import SectionHead from '../components/SectionHead.astro'
import CtaBand from '../components/CtaBand.astro'
import FactText from '../components/FactText.astro'
import ConfirmTag from '../components/ConfirmTag.astro'
import Icon from '../components/Icon.astro'
import { academy, locations } from '../data/site'
import { pathway } from '../data/training'
import { REVIEW_MODE, fact, needsTag, visible } from '../lib/review'

const shownLocations = visible(locations)

/**
 * The academy's own story. Replace the placeholder with text from the Wix
 * "About Us" page (or new text from the academy) and set confirmed: true.
 */
const story = [
  fact(
    `${academy.name} (VSA) is a karate academy in ${academy.area.text}, led by its president, ${academy.president}.`,
    true,
  ),
  fact(
    'It trains students from the age of 4, whether they want self-defence, fitness or competition, and prepares them for district, state, national and international tournaments.',
    true,
    'Wix blog post, 21 January 2025',
  ),
  fact(
    'VSA also presents the Vishwa Cup, a state-level invitational karate championship. Its fourth edition, in December 2024, was hosted in affiliation with the Traditional Shotokan and Sports Karate Organisation (TSSKO).',
    true,
    'Wix blog post, 5 December 2024',
  ),
  fact(
    'The academy’s history and training philosophy, in its own words, will appear here.',
    false,
    'Placeholder: the Wix “About Us” page text could not be read through the Wix API. Paste it in or supply new text.',
  ),
]
---

<BaseLayout
  title="About Us"
  description={`About ${academy.name} (VSA): a karate academy in Pimpri-Chinchwad led by ${academy.president}, training students from age 4 and presenting the Vishwa Cup championship.`}
>
  <PageHero
    eyebrow="About us"
    title="About Vishwa Sports Academy"
    lead={academy.motto}
    kanji="空手"
  />

  <section class="section on-light" aria-labelledby="story-title">
    <div class="container story">
      <div data-reveal>
        <p class="eyebrow">Our story</p>
        <h2 class="h2" id="story-title" style="margin-top: var(--s-5)">The academy</h2>
      </div>
      <div class="prose story__text" data-reveal style="--reveal-i: 1">
        {story.map((p, i) => <FactText fact={p} as="p" class={i === 0 ? 'lead' : undefined} />)}
        <dl class="facts">
          <div><dt>Academy</dt><dd>{academy.name} ({academy.shortName})</dd></div>
          <div><dt>President</dt><dd>{academy.president}</dd></div>
          <div><dt>Discipline</dt><dd>Karate</dd></div>
          {visible([academy.area]).length > 0 && <div><dt>Based in</dt><FactText fact={academy.area} as="dd" /></div>}
        </dl>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="meaning-title">
    <div class="container meaning">
      <div class="meaning__kanji jp" aria-hidden="true" data-reveal>
        <span>空</span><span>手</span><span>道</span>
      </div>
      <div data-reveal style="--reveal-i: 1">
        <p class="eyebrow">What karate means</p>
        <h2 class="h2" id="meaning-title" style="margin-top: var(--s-5)">The way of the empty hand</h2>
        <div class="prose" style="margin-top: var(--s-6)">
          <p class="lead muted">
            <span lang="ja-Latn">Karate-dō</span> (<span lang="ja">空手道</span>) is written with three characters:
            <em>kara</em>, empty; <em>te</em>, hand; and <em>dō</em>, way.
          </p>
          <p class="muted">
            It is a martial art practised without weapons. Students build technique through basics (<span lang="ja-Latn">kihon</span>), forms
            (<span lang="ja-Latn">kata</span>) and sparring (<span lang="ja-Latn">kumite</span>), and move up through coloured belts by passing graded
            examinations.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section on-ink-2" aria-labelledby="pathway-title">
    <div class="container">
      <SectionHead eyebrow="How training works" title="The VSA pathway" id="pathway-title" />
      <ol class="steps" role="list">
        {
          pathway.map((step, i) => (
            <li class="step" data-reveal style={`--reveal-i: ${i}`}>
              <span class="step__n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="h3">{step.title}</h3>
              <p class="muted">{step.description}</p>
              {'href' in step && (
                <a href={step.href} class="text-link">
                  See events <Icon name="arrow" />
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    shownLocations.length > 0 && (
      <section class="section" aria-labelledby="locations-title">
        <div class="container">
          <SectionHead eyebrow="Where we train" title="Locations" id="locations-title" split>
            {REVIEW_MODE && (
              <p class="muted">
                Aundh comes from the academy’s own announcement. The other addresses come from public business listings
                and must be checked by the academy, as must the full list of branches.
              </p>
            )}
          </SectionHead>
          <ul class="locations" role="list">
            {shownLocations.map((loc) => (
              <li class="location" data-reveal>
                <Icon name="pin" />
                <div>
                  <h3 class="h3">
                    {loc.name}
                    {needsTag(loc) && <ConfirmTag source={loc.source} />}
                  </h3>
                  <p class="muted">{loc.address}</p>
                  {loc.note && <p class="location__note">{loc.note}</p>}
                  {loc.mapUrl && (
                    <a class="text-link" href={loc.mapUrl} target="_blank" rel="noopener noreferrer">
                      Open in Maps <Icon name="arrow" />
                      <span class="visually-hidden"> (opens in a new tab)</span>
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand />
</BaseLayout>

<style>
  .story {
    display: grid;
    gap: var(--s-7);
  }

  @media (min-width: 960px) {
    .story {
      grid-template-columns: 1fr 1.3fr;
      gap: var(--s-9);
    }
  }

  .story__text .facts {
    margin-top: var(--s-6);
  }


  .meaning {
    display: grid;
    gap: var(--s-7);
    align-items: center;
  }

  @media (min-width: 900px) {
    .meaning {
      grid-template-columns: auto 1fr;
      gap: var(--s-9);
    }
  }

  .meaning__kanji {
    display: flex;
    gap: var(--s-3);
    font-size: clamp(4rem, 10vw, 7rem);
    line-height: 1;
  }

  @media (min-width: 900px) {
    .meaning__kanji {
      flex-direction: column;
    }
  }

  .meaning__kanji span:nth-child(2) {
    color: var(--red-on-dark);
  }

  .steps {
    display: grid;
    gap: var(--s-4);
    margin: 0;
    padding: 0;
  }

  @media (min-width: 860px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .step {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--s-3);
    padding: var(--s-6);
    border: 1px solid var(--line);
  }

  .step__n {
    font-size: var(--step-3);
    font-weight: 850;
    color: var(--red-on-dark);
    font-variation-settings: 'wdth' 120;
  }

  .locations {
    display: grid;
    gap: var(--s-4);
    margin: 0;
    padding: 0;
  }

  @media (min-width: 760px) {
    .locations {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .location {
    display: flex;
    gap: var(--s-4);
    padding: var(--s-6);
    border: 1px solid var(--line);
  }

  .location > :global(svg) {
    width: 24px;
    height: 24px;
    flex: none;
    color: var(--red-on-dark);
  }

  .location__note {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .location div {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
  }
</style>
